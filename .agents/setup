#!/usr/bin/env bash
# Amp orb setup: installs the PHP 8.3 toolchain and all project dependencies.
# Safe to run repeatedly; a warm run skips package downloads and reinstalls.
set -euo pipefail

step() {
    echo "==> [setup] $(date -u +%H:%M:%S) $*"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# System packages need root; dependency managers must run as the "user"
# account so vendor/, node_modules/ and their caches stay writable by Amp.
# Amp runs this script as "user", which has passwordless sudo. Both run_user variants take one
# shell command line, so commands with pipes and quoting behave the same either way.
if [ "$(id -u)" -eq 0 ]; then
    as_root() {
        "$@"
    }
    run_user() {
        sudo -u user -H bash -c "cd '$repo_root' && $*"
    }
else
    as_root() {
        sudo -n "$@"
    }
    run_user() {
        bash -c "cd '$repo_root' && $*"
    }
fi

# --- PHP 8.3 (Sury repository, Debian's default is 8.2) ---
PHP_PACKAGES=(
    php8.3-cli
    php8.3-mbstring
    php8.3-xml
    php8.3-curl
    php8.3-sqlite3
    php8.3-zip
    php8.3-intl
    php8.3-bcmath
    php8.3-gd
)

missing_php_packages=()
for package in "${PHP_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
        missing_php_packages+=("$package")
    fi
done

if [ "${#missing_php_packages[@]}" -gt 0 ]; then
    step "Installing PHP 8.3 packages: ${missing_php_packages[*]}"
    as_root apt-get update -qq
    as_root apt-get install -y -qq ca-certificates curl gnupg2 >/dev/null
    as_root install -d /usr/share/keyrings
    as_root curl -fsSL https://packages.sury.org/php/apt.gpg -o /usr/share/keyrings/sury-php.gpg
    echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php bookworm main" \
        | as_root tee /etc/apt/sources.list.d/sury-php.list >/dev/null
    as_root apt-get update -qq
    as_root apt-get install -y -qq "${missing_php_packages[@]}" >/dev/null
else
    step "PHP 8.3 packages already installed"
fi

# --- Composer ---
if ! command -v composer >/dev/null 2>&1; then
    step "Installing Composer"
    as_root curl -fsSL https://getcomposer.org/download/latest-stable/composer.phar -o /usr/local/bin/composer
    as_root chmod +x /usr/local/bin/composer
else
    step "Composer already installed: $(composer --version 2>/dev/null | head -1)"
fi

# --- PHP dependencies ---
step "Installing PHP dependencies"
run_user composer install --no-interaction --no-progress

# --- Node dependencies ---
# npm ci is deterministic, keeps package-lock.json untouched (npm install
# would rewrite it), and uses the npm cache on warm runs.
step "Installing Node dependencies"
run_user npm ci --no-audit --no-fund --loglevel=error

# --- Vitest browser mode (vitest.config.ts runs the tests in Playwright's Chromium) ---
step "Installing Playwright Chromium"
# install-deps calls apt-get itself, so it needs root and node_modules/.bin on the PATH.
as_root env PATH="$repo_root/node_modules/.bin:$PATH" playwright install-deps chromium >/dev/null
run_user npx playwright install chromium

# --- Admin panel playground (Testbench, served by .amp/services.yaml) ---
step "Preparing the admin panel playground"
run_user npm run build --silent
run_user touch vendor/orchestra/testbench-core/laravel/database/database.sqlite
run_user vendor/bin/testbench migrate --force --no-interaction
run_user vendor/bin/testbench larasell:link || true
run_user vendor/bin/testbench larasell:create-admin --name=Admin --email=admin@example.com --password=Password-123! || true
# Sample categories, products and customers; skipped once the playground has categories.
run_user vendor/bin/testbench db:seed --class="'Workbench\Database\Seeders\DatabaseSeeder'" --force --no-interaction

step "Setup complete"

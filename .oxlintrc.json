{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "react-perf", "vitest"],
  "jsPlugins": ["./lint/plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "larasell/no-margin": "error"
  },
  "ignorePatterns": ["public/**", "vendor/**", "workbench/**"]
}

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/larasell-dev/phpstan-rules/extension.neon

parameters:
    paths:
        - src
        - tests/Fixtures
        - lint/PHPStan
    excludePaths:
        - lint/PHPStan/data

    level: 8
    databaseMigrationsPath:
        - database/migrations
